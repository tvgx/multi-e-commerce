{
  "name": "@ecommerce/i18n",
  "version": "1.0.0",
  "description": "Centralized internationalization and translation system supporting Vietnamese and English across the e-commerce platform",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "tsc --project tsconfig.json --watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/**/*.ts",
    "clean": "rm -rf dist/"
  },
  "keywords": [
    "i18n",
    "internationalization",
    "translations",
    "multilingual",
    "vietnamese",
    "english",
    "language"
  ],
  "author": "E-commerce Platform Team",
  "license": "MIT",
  "dependencies": {
    "i18next": "^23.7.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-i18next": "^14.0.0 || ^15.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-i18next": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ecommerce-platform/ecommerce-platform.git",
    "directory": "packages/i18n"
  }
}