  order           Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant         Variant      @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@map("line_items")
}

// ==========================================
// Payment Models
// ==========================================

model PaymentMethod {
  id          String   @id @default(uuid())
  shopId      String
  name        String
  description String?
  type        String   // vd: "Stripe", "COD", "BankTransfer"
  active      Boolean  @default(true)

  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  payments    Payment[]

  @@unique([shopId, type])
  @@map("payment_methods")
}

model Payment {
  id              String   @id @default(uuid())
  orderId         String
  paymentMethodId String
  amount          Float
  state           String   @default("checkout") // checkout, awaiting_confirmation, processing, completed, failed, void, refunded
  responseCode    String?

  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id])

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([orderId])
  @@map("payments")
}

model PaymentConfirmToken {
  id        String   @id @default(uuid())
  token     String   @unique  // JWT or signed UUID
  orderId   String
  paymentId String
  shopId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([shopId])
  @@index([orderId])
  @@map("payment_confirm_tokens")
}

// ==========================================
// Promotion & Coupon Models
// ==========================================

model Promotion {
  id          String   @id @default(uuid())
  shopId      String
  name        String
  description String?
  code        String?  // Global code (vd: "NEWYEAR")
  usageLimit  Int?
  usedCount   Int      @default(0)
  startsAt    DateTime?
  expiresAt   DateTime?
  isActive    Boolean  @default(false)
  discountType  String   @default("PERCENTAGE") // PERCENTAGE | FIXED_AMOUNT
  discountValue Float    @default(0)
  createdAt     DateTime @default(now())

  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  usages      PromotionUsage[]

  @@unique([shopId, code])
  @@index([shopId])
  @@map("promotions")
}

model PromotionUsage {
  id          String   @id @default(uuid())
  promotionId String
  customerId  String
  orderId     String
  shopId      String
  usedAt      DateTime @default(now())

  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@index([promotionId])
  @@index([customerId])
  @@map("promotion_usages")
}

// ==========================================
// Content Models (Collections, Pages, Navigation)
// ==========================================

model Collection {
  id          String   @id @default(uuid())
  shopId      String
  title       String
  slug        String   // vd: men, new-arrivals, sale
  description String?
  imageUrl    String?
  isActive    Boolean  @default(true)

  shop        Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  products    ProductCollection[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([shopId, slug])
  @@index([shopId])
  @@map("collections")
}

// Bảng trung gian N-N: Product <-> Collection
model ProductCollection {
  productId    String
  collectionId String
  order        Int    @default(0) // Thứ tự hiển thị trong Collection

  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
  @@index([collectionId])
  @@map("product_collections")
}

// Header/Footer menu của từng shop
model NavigationMenu {
  id      String @id @default(uuid())
  shopId  String
  handle  String // "main-menu" (header) | "footer-menu"
  title   String
  // items: Array of { title: string, url: string, items?: NavigationItem[] }
  items   Json   @default("[]")

  shop    Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shopId, handle])
  @@index([shopId])
  @@map("navigation_menus")
}

// Custom Pages: /pages/about, /pages/faq — do user tạo
model ShopPage {
  id        String   @id @default(uuid())
  shopId    String
  slug      String   // vd: about, faq, contact
  title     String
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, slug])
  @@index([shopId])
  @@map("shop_pages")
}

// ==========================================
// Media & Storage Management Models
// ==========================================

model Media {
  id        String   @id @default(uuid())
  shopId    String
  url       String
  key       String   // S3/MinIO key (prefix/filename)
  bucket    String   // shop-public or shop-private
  mimeType  String
  size      Int      // In bytes
  width     Int?
  height    Int?
  blurHash  String?  // For premium loading experience
  alt       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@map("media")
}


// ==========================================
// Interactions Models (Wishlist, Reviews, Search)
// ==========================================

model WishlistItem {
  id          String   @id @default(uuid())
  shopId      String
  customerId  String
  productId   String
  variantId   String?
  createdAt   DateTime @default(now())

  @@unique([customerId, productId])
  @@index([shopId])
  @@map("wishlist_items")
}

model ProductReview {
  id          String   @id @default(uuid())
  shopId      String
  customerId  String
  productId   String
  orderId     String?
  rating      Int
  title       String?
  body        String?
  status      String   @default("published") // published, pending, hidden
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([shopId])
  @@index([productId])
  @@index([customerId])
  @@map("product_reviews")
}

model SearchHistory {
  id          String   @id @default(uuid())
  shopId      String
  customerId  String
  query       String
  createdAt   DateTime @default(now())

  @@index([customerId])
  @@index([shopId])
  @@map("search_history")
}

// ==========================================
// Notifications Models
// ==========================================

model Notification {
  id            String   @id @default(uuid())
  shopId        String
  recipientId   String
  recipientType String   // "CUSTOMER" | "OWNER"
  type          String   // e.g., "ORDER_CONFIRMED", "PAYMENT_SUCCESS"
  title         String
  body          String
  data          Json?    @default("{}")
  readAt        DateTime?
  createdAt     DateTime @default(now())

  @@index([shopId])
  @@index([recipientId, recipientType])
  @@map("notifications")
}
