model Order {
  id            String   @id @default(uuid())
  number        String   @unique // Public Order Number (vd: R123456789)
  shopId        String
  customerId    String

  state         String   @default("cart") // cart, address, delivery, payment, confirm, complete, canceled
  paymentState  String   @default("balance_due") // balance_due, paid, credit_owed, void
  shipmentState String   @default("pending") // pending, ready, shipped, partial

  totalAmount     Float    @default(0)
  itemTotal       Float    @default(0)
  adjustmentTotal Float    @default(0)
  promoTotal      Float    @default(0)
  taxTotal        Float    @default(0)
  shipmentTotal   Float    @default(0)

  currency      String   @default("VND")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  shop          Shop          @relation(fields: [shopId], references: [id])
  customer      Customer      @relation(fields: [customerId], references: [id])
  lineItems     LineItem[]
  payments      Payment[]

  @@index([shopId])
  @@index([number])
  @@map("orders")
}

model LineItem {
  id              String @id @default(uuid())
  orderId         String
  variantId       String
  quantity        Int
  price           Float
