// ==========================================
// Authentication & User Models
// ==========================================

enum Role {
  ADMIN
  OWNER
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  name          String?   // Better Auth standard
  emailVerified Boolean   @default(false)
  image         String?   // User avatar

  // Project specific fields
  fullName       String? // Họ và tên đầy đủ
  identityNumber String? // Căn cước công dân (CCCD) / Hộ chiếu
  dateOfBirth    DateTime? // Ngày tháng năm sinh
  gender         String? // Giới tính (MALE, FEMALE, OTHER)

  role      Role     @default(OWNER) // ADMIN, OWNER
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions Session[]
  accounts Account[]
  shops    Shop[]

  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
