// ==========================================
// Media & Storage Management Models
// ==========================================

model Media {
  id        String   @id @default(uuid())
  shopId    String
  url       String
  key       String   // S3/MinIO key (prefix/filename)
  bucket    String   // shop-public or shop-private
  mimeType  String
  size      Int      // In bytes
  width     Int?
  height    Int?
  blurHash  String?  // For premium loading experience
  alt       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@map("media")
}

