// ==========================================
// Server-side Cart Models
// ==========================================
// Giỏ hàng lưu server. Khách đã đăng nhập gắn theo customerId (đồng bộ giữa
// thiết bị); khách vãng lai (guest) gắn theo guestToken (cookie ẩn danh) và
// được MERGE vào giỏ của khách khi họ đăng nhập/đăng ký.
// Checkout vẫn nhận lineItems trực tiếp; nếu không truyền lineItems thì
// OrderService đọc từ cart này và clear sau khi đặt.

model Cart {
  id         String   @id @default(uuid())
  shopId     String
  // Đúng MỘT trong customerId / guestToken được set. Postgres cho phép nhiều
  // NULL trong unique index nên giỏ customer và giỏ guest cùng tồn tại.
  customerId String?
  guestToken String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  shop     Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer Customer?  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    CartItem[]

  @@unique([shopId, customerId]) // Mỗi khách một giỏ trên mỗi shop
  @@unique([shopId, guestToken]) // Mỗi phiên guest một giỏ trên mỗi shop
  @@index([shopId])
  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  variantId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId]) // Thêm trùng variant thì tăng quantity
  @@index([variantId])
  @@map("cart_items")
}
