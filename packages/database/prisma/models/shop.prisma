// ==========================================
// Shop & Customer Models
// ==========================================

model Shop {
  id      String  @id @default(uuid())
  ownerId String
  name    String
  domain  String? @unique // Custom domain (vd: store.duck.com)
  status           String    @default("DRAFT") // DRAFT, PUBLISHED
  templateType     String    @default("standard")
  onboardingStep   Int       @default(1)
  onboardingStatus Json?     @default("{}")
  domainVerified   Boolean   @default(false)
  bankAccount      ShopBankAccount?

  // Thông tin định danh doanh nghiệp
  businessLicenseNumber     String? // Mã số thẻ kinh doanh
  businessLicenseIssuedDate DateTime? // Ngày cấp

  // Thông tin lưu trữ (tích hợp từ StorageUsage)
  storageUsedBytes   BigInt    @default(0)
  storageTotalLimit  BigInt    @default(1073741824) // Default 1GB
  storageChunkCount  Int       @default(0)
  storageLastUpdated DateTime  @default(now()) @updatedAt

  currency         String    @default("VND")
  productsPerPage Int @default(30)

  createdAt DateTime @default(now())

  owner     User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  customers Customer[]
  orders    Order[]
  products  Product[]
  stockLocations StockLocation[]
  promotions Promotion[]
  paymentMethods PaymentMethod[]
  collections    Collection[]
  navigationMenus NavigationMenu[]
  shopPages      ShopPage[]
  media          Media[]

  variants           Variant[]
  stockMovements     StockMovement[]
  customerAddresses  CustomerAddress[]
  shopFeatures       ShopFeature[]

  @@map("shops")
}

model ShopBankAccount {
  id            String   @id @default(uuid())
  shopId        String   @unique
  bankName      String
  accountNumber String
  accountHolder String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  shop          Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@map("shop_bank_accounts")
}

model Customer {
  id             String    @id @default(uuid())
  shopId         String
  email          String
  emailVerified  Boolean   @default(false) // Better Auth standard
  name           String?
  image          String?   // Avatar URL
  phoneNumber    String?   // Số điện thoại

  customerSessions CustomerSession[]
  customerAccounts CustomerAccount[]
  orders           Order[]
  addresses        CustomerAddress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, email]) // Mỗi shop có tập khách hàng riêng
  @@map("customers")
}

model CustomerSession {
  id          String   @id
  expiresAt   DateTime
  token       String   @unique
  createdAt   DateTime
  updatedAt   DateTime
  ipAddress   String?
  userAgent   String?
  customerId  String
  shopId      String   // Để scope session theo tenant
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@map("customer_sessions")
}

model CustomerAccount {
  id                    String    @id
  accountId             String
  providerId            String
  customerId            String
  customer              Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?   // Hashed password
  createdAt             DateTime
  updatedAt             DateTime

  @@map("customer_accounts")
}

model CustomerVerification {
  id         String    @id
  identifier String    // email hoặc shopId:email
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("customer_verifications")
}

model CustomerAddress {
  id           String   @id @default(uuid())
  customerId   String
  shopId       String
  fullName     String
  phone        String
  addressLine1 String
  city         String
  province     String
  postalCode   String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  shop         Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([shopId])
  @@map("customer_addresses")
}

model ShopFeature {
  id        String   @id @default(uuid())
  shopId    String
  feature   String   // e.g., 'advanced_analytics', 'custom_domain'
  createdAt DateTime @default(now())

  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, feature])
  @@index([shopId])
  @@map("shop_features")
}
