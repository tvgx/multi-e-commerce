// ==========================================
// Shop & Customer Models
// ==========================================

model Shop {
  id      String  @id @default(uuid())
  ownerId String
  name    String
  domain  String? @unique // Custom domain (vd: store.duck.com)
  status           String    @default("DRAFT") // DRAFT, PUBLISHED
  templateType     String    @default("standard")
  onboardingStep   Int       @default(1)
  onboardingStatus Json?     @default("{}")
  domainVerified   Boolean   @default(false)
  bankAccount      Json?     @default("{}") // { bankName, accountNumber, accountHolder }

  // Thông tin định danh doanh nghiệp (Có thể tách ra bảng riêng BusinessLicense nếu phức tạp)
  mapAddress        String? // Tọa độ hoặc địa chỉ map
  licenseImageUrl   String? // Ảnh giấy phép kinh doanh
  licenseIssuedDate DateTime?
  licenseIssuedBy   String? // Nơi cấp
  licenseExpiryDate DateTime?

  currency         String    @default("VND")
  productsPerPage Int @default(30)

  createdAt DateTime @default(now())

  owner     User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  customers Customer[]
  orders    Order[]
  products  Product[]
  stockLocations StockLocation[]
  promotions Promotion[]
  paymentMethods PaymentMethod[]
  collections    Collection[]
  navigationMenus NavigationMenu[]
  shopPages      ShopPage[]

  media              Media[]
  storageUsage       StorageUsage?

  @@map("shops")
}

model Customer {
  id             String    @id @default(uuid())
  shopId         String
  email          String
  emailVerified  Boolean   @default(false) // Better Auth standard
  name           String?
  image          String?   // Avatar URL
  phoneNumber    String?   // Số điện thoại

  // Sessions & Accounts for Better Auth (Customer scope)
  customerSessions CustomerSession[]
  customerAccounts CustomerAccount[]
  orders           Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, email]) // Mỗi shop có tập khách hàng riêng
  @@map("customers")
}

model CustomerSession {
  id          String   @id
  expiresAt   DateTime
  token       String   @unique
  createdAt   DateTime
  updatedAt   DateTime
  ipAddress   String?
  userAgent   String?
  customerId  String
  shopId      String   // Để scope session theo tenant
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@map("customer_sessions")
}

model CustomerAccount {
  id                    String    @id
  accountId             String
  providerId            String
  customerId            String
  customer              Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?   // Hashed password
  createdAt             DateTime
  updatedAt             DateTime

  @@map("customer_accounts")
}

model CustomerVerification {
  id         String    @id
  identifier String    // email hoặc shopId:email
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("customer_verifications")
}
