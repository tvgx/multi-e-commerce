// ==========================================
// Shop & Customer Models
// ==========================================

model Shop {
  id      String  @id @default(uuid())
  ownerId String
  name    String
  domain  String? @unique // Custom domain (vd: store.duck.com)
  status           String    @default("DRAFT") // DRAFT, PUBLISHED
  templateType     String    @default("standard")
  onboardingStep   Int       @default(1)
  onboardingStatus Json?     @default("{}")
  domainVerified   Boolean   @default(false)

  // Thông tin định danh doanh nghiệp (Có thể tách ra bảng riêng BusinessLicense nếu phức tạp)
  mapAddress        String? // Tọa độ hoặc địa chỉ map
  licenseImageUrl   String? // Ảnh giấy phép kinh doanh
  licenseIssuedDate DateTime?
  licenseIssuedBy   String? // Nơi cấp
  licenseExpiryDate DateTime?

  productsPerPage Int @default(30)

  createdAt DateTime @default(now())

  owner     User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  customers Customer[]
  orders    Order[]
  products  Product[]
  stockLocations StockLocation[]
  markets   Market[]
  zones     Zone[]
  taxCategories TaxCategory[]
  promotions Promotion[]
  paymentMethods PaymentMethod[]
  collections    Collection[]
  navigationMenus NavigationMenu[]
  shopPages      ShopPage[]

  mergedLayoutsCache MergedLayoutsCache?

  @@map("shops")
}

model Customer {
  id     String  @id @default(uuid())
  shopId String
  email  String
  name   String?
  orders Order[]

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, email]) // Mỗi shop có tập khách hàng riêng
  @@map("customers")
}
