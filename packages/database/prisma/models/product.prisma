// ==========================================
// Product Models
// ==========================================

model Product {
  id          String   @id @default(uuid())
  shopId      String
  name        String
  slug        String   // URL thân thiện (vd: ao-thun-nam)
  description String?  // Mô tả ngắn (Mô tả dài nằm ở MongoDB)
  status      String   @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED
  categoryId  String?
  imageUrl    String?  // Ảnh đại diện sản phẩm (= images[0], giữ cho tương thích)
  images      String[] @default([]) // Toàn bộ ảnh sản phẩm theo thứ tự hiển thị
  shop        Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants      Variant[]
  optionTypes   ProductOptionType[]
  collections   ProductCollection[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([shopId, slug])
  @@index([shopId])
  @@index([shopId, createdAt]) // paginated product lists sort by createdAt
  @@index([shopId, status])    // status filter in findAllProducts
  @@index([categoryId])        // category filter in findAllProducts
  // Trigram GIN: search `contains` (ILIKE '%term%') trong findAllProducts — cần pg_trgm
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("products")
}

// Danh mục sản phẩm dạng cây (parentId), riêng theo từng shop
model Category {
  id          String   @id @default(uuid())
  shopId      String
  name        String
  slug        String   // URL thân thiện (vd: ao-nam)
  description String?
  imageUrl    String?
  parentId    String?
  position    Int      @default(0) // Thứ tự hiển thị giữa các danh mục cùng cấp
  isActive    Boolean  @default(true)

  shop        Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryTree")
  products    Product[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([shopId, slug])
  @@index([shopId])
  @@index([parentId])
  @@map("categories")
}

model Variant {
  id          String   @id @default(uuid())
  shopId      String
  productId   String
  sku         String
  price       Float    @default(0)
  currency    String   @default("VND")
  weight      Float?   // Cân nặng (KG)
  isMaster    Boolean  @default(false) // Biến thể chính của sản phẩm

  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionValues VariantOptionValue[]
  stockItems  StockItem[]
  lineItems   LineItem[]
  cartItems   CartItem[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([shopId, sku])
  @@index([shopId])
  @@index([productId])
  // Trigram GIN: search theo SKU (ILIKE '%term%') trong findAllProducts
  @@index([sku(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("product_variants")
}

model OptionType {
  id           String   @id @default(uuid())
  shopId       String
  name         String   // vd: Color, Size
  presentation String   // vd: Màu sắc, Kích thước

  optionValues OptionValue[]
  productTypes ProductOptionType[]

  @@index([shopId])
  @@map("option_types")
}

model OptionValue {
  id           String   @id @default(uuid())
  optionTypeId String
  name         String   // vd: red, xl
  presentation String   // vd: Đỏ, XL

  optionType   OptionType @relation(fields: [optionTypeId], references: [id], onDelete: Cascade)
  variantValues VariantOptionValue[]

  @@index([optionTypeId])
  @@map("option_values")
}

// Bảng trung gian nối Product với các OptionType khả dụng
model ProductOptionType {
  id           String @id @default(uuid())
  productId    String
  optionTypeId String

  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionType   OptionType @relation(fields: [optionTypeId], references: [id], onDelete: Cascade)

  @@unique([productId, optionTypeId])
  @@map("product_option_types")
}

// Bảng trung gian nối Variant với các OptionValue cụ thể
model VariantOptionValue {
  id            String @id @default(uuid())
  variantId     String
  optionValueId String

  variant      Variant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue  OptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@unique([variantId, optionValueId])
  @@map("variant_option_values")
}
