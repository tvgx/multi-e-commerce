// ==========================================
// Authentication & User Models
// ==========================================

enum Role {
  ADMIN
  OWNER
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  name          String?   // Better Auth standard
  emailVerified Boolean   @default(false)
  image         String?   // User avatar

  // Project specific fields
  fullName       String? // Họ và tên đầy đủ
  identityNumber String? // Căn cước công dân (CCCD) / Hộ chiếu
  dateOfBirth    DateTime? // Ngày tháng năm sinh
  gender         String? // Giới tính (MALE, FEMALE, OTHER)

  role      Role     @default(OWNER) // ADMIN, OWNER
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions Session[]
  accounts Account[]
  shops    Shop[]

  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@index([userId]) // better-auth tra account theo user khi login
  @@map("accounts")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@index([identifier]) // better-auth tra verification theo identifier
  @@map("verifications")
}
