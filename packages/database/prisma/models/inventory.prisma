// ==========================================
// Inventory & Stock Models
// ==========================================

model StockLocation {
  id                   String   @id @default(uuid())
  shopId               String
  name                 String
  adminName            String?
  active               Boolean  @default(true)
  isDefault            Boolean  @default(false)

  shop                 Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  stockItems           StockItem[]

  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  @@index([shopId])
  @@map("stock_locations")
}

model StockItem {
  id              String   @id @default(uuid())
  stockLocationId String
  variantId       String
  countOnHand     Int      @default(0)
  backorderable   Boolean  @default(false)

  stockLocation   StockLocation @relation(fields: [stockLocationId], references: [id], onDelete: Cascade)
  variant         Variant       @relation(fields: [variantId], references: [id], onDelete: Cascade)

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([stockLocationId, variantId])
  @@map("stock_items")
}
