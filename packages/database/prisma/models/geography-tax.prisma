// ==========================================
// Geography & Tax Models
// ==========================================

model Market {
  id              String   @id @default(uuid())
  shopId          String
  name            String
  currency        String   @default("VND")
  defaultLocale   String   @default("vi")
  taxInclusive    Boolean  @default(true)
  isActive        Boolean  @default(true)

  shop            Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  marketCountries MarketCountry[]

  @@index([shopId])
  @@map("markets")
}

model Country {
  id              String   @id @default(uuid())
  iso             String   @unique // vd: "VN", "US"
  name            String

  marketCountries MarketCountry[]
  zoneMembers     ZoneMember[]

  @@map("countries")
}

model MarketCountry {
  id        String   @id @default(uuid())
  marketId  String
  countryId String

  market    Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)
  country   Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@unique([marketId, countryId])
  @@map("market_countries")
}

model Zone {
  id          String   @id @default(uuid())
  shopId      String
  name        String
  kind        String   // country, state

  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  members     ZoneMember[]
  taxRates    TaxRate[]

  @@map("zones")
}

model ZoneMember {
  id        String   @id @default(uuid())
  zoneId    String
  countryId String

  zone      Zone     @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  country   Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@index([zoneId])
  @@map("zone_members")
}

model TaxCategory {
  id          String   @id @default(uuid())
  shopId      String
  name        String
  isDefault   Boolean  @default(false)
  taxCode     String?

  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  taxRates    TaxRate[]
  products    Product[]

  @@map("tax_categories")
}

model TaxRate {
  id            String   @id @default(uuid())
  taxCategoryId String
  zoneId        String
  name          String
  amount        Float    @default(0) // Percentage (vd: 0.1 for 10%)
  included      Boolean  @default(false)

  taxCategory   TaxCategory @relation(fields: [taxCategoryId], references: [id], onDelete: Cascade)
  zone          Zone        @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@map("tax_rates")
}
