    {
      "name": "04. Shops",
      "item": [
        {
          "name": "POST /api/v1/tenants/register (UC-01)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('UC-01: Status code is 201', function () {",
                  "  pm.expect(pm.response.code).to.equal(201);",
                  "});",
                  "",
                  "pm.test('UC-01: Response has tenantId', function () {",
                  "  var data = pm.response.json().data;",
                  "  pm.expect(data).to.have.property('tenantId');",
                  "  pm.environment.set('tenantId', data.tenantId);",
                  "});",
                  "",
                  "pm.test('UC-01: Response has status=active', function () {",
                  "  var data = pm.response.json().data;",
                  "  pm.expect(data.status).to.equal('active');",
                  "});",
                  "",
                  "pm.test('UC-01: Response includes shopName, domain, email', function () {",
                  "  var data = pm.response.json().data;",
                  "  pm.expect(data).to.have.property('shopName');",
                  "  pm.expect(data).to.have.property('domain');",
                  "  pm.expect(data).to.have.property('email');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shopName\": \"My Test Shop\",\n  \"email\": \"owner@myshop.com\",\n  \"domain\": \"myshop\",\n  \"ownerName\": \"John Smith\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/tenants/register"
