      "name": "1. GET Layout (First Time - No Cache)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/layouts/{{tenantId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "layouts",
            "{{tenantId}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "2. GET Layout (Second Time - Check Response Time < 10ms)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/layouts/{{tenantId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "layouts",
            "{{tenantId}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "3. POST Publish Layout (Invalidates Cache)",
