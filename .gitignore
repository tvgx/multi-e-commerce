# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules
.pnp
.pnp.js

# Local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Testing
coverage

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
.next/
out/
build
dist
# ...but a bare `build`/`dist` also matches SOURCE dirs of the same name
# (e.g. the NestJS module apps/api-core/src/modules/build/). Build output never
# lives under a src/ tree, so re-include any build/dist dir that does.
!**/src/**/build/
!**/src/**/dist/


# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.DS_Store
*.pem
.cloudflared/
cloudflared/
tunnel-credentials.json

# Agent/AI Directories
master-template-example/


.early.coverage*:Zone.Identifier

# Python bytecode
__pycache__/
*.pyc

# Env backups
.env.prod-backup*
