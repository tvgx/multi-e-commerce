# ============================================================================
# Production env cho docker-compose.prod.yaml — COPY thành `.env` rồi điền thật:
#     cp .env.prod.example .env
# KHÔNG commit file .env (đã nằm trong .gitignore).
#
# Sinh secret ngẫu nhiên:  openssl rand -hex 32
#
# LƯU Ý: các biến NEXT_PUBLIC_* KHÔNG nằm ở đây — chúng được bake vào image
# frontend LÚC BUILD trên CI (xem .github/workflows/ci-cd.yml + repo Variables).
# ============================================================================

# ── Domain / TLS ─────────────────────────────────────────────────────────────
ROOT_DOMAIN=tvgx1.id.vn
ACME_EMAIL=you@example.com            # email đăng ký Let's Encrypt

# ── Image overrides (tùy chọn) ───────────────────────────────────────────────
# Mặc định trỏ ghcr.io/tvgx/multi-e-commerce-<svc>:latest. Đổi nếu owner/repo khác:
# API_CORE_IMAGE=ghcr.io/<owner>/<repo>-api-core:latest
# ADMIN_IMAGE=ghcr.io/<owner>/<repo>-admin:latest
# STOREFRONT_IMAGE=ghcr.io/<owner>/<repo>-storefront:latest
# SHOP_BUILDER_IMAGE=ghcr.io/<owner>/<repo>-shop-builder:latest

# ── PostgreSQL (Supabase free) ───────────────────────────────────────────────
# DATABASE_URL = pooler (:6543, pgbouncer) cho runtime.
# DIRECT_URL   = direct (:5432) cho prisma migrate deploy.
DATABASE_URL=postgresql://USER:PASS@HOST:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://USER:PASS@HOST:5432/postgres

# ── MongoDB (Atlas M0 free) ──────────────────────────────────────────────────
MONGO_DB_ATLAS=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/

# ── Object storage (MinIO chạy trên box) ─────────────────────────────────────
# MINIO_ACCESS_KEY/SECRET cũng là MINIO_ROOT_USER/PASSWORD của container minio.
# MINIO_ENDPOINT/PORT/USE_SSL do compose set sẵn (minio:9000, không SSL nội bộ).
MINIO_ACCESS_KEY=CHANGE_ME_minio_user
MINIO_SECRET_KEY=CHANGE_ME_minio_password_min_8_chars
MINIO_BUCKET=shop-images
MINIO_REGION=us-east-1
# URL công khai để browser tải ảnh trực tiếp (path-style: /<bucket>/<key>).
CDN_BASE_URL=https://cdn.tvgx1.id.vn

# ── Auth (better-auth) ───────────────────────────────────────────────────────
BETTER_AUTH_SECRET=CHANGE_ME_openssl_rand_hex_32
BETTER_AUTH_URL=https://api.tvgx1.id.vn
# Chia sẻ cookie giữa admin./api./*.<domain> (id.vn là public suffix → same-site).
COOKIE_DOMAIN=.tvgx1.id.vn

# ── CORS / origins (api-core đọc) ────────────────────────────────────────────
ADMIN_URL=https://admin.tvgx1.id.vn
STOREFRONT_URL=https://tvgx1.id.vn
# CORS cũng tự cho phép mọi *.${ROOT_DOMAIN} (tenant storefront) — đã set ở trên.

# ── Internal secrets ─────────────────────────────────────────────────────────
INTERNAL_API_KEY=CHANGE_ME_openssl_rand_hex_24      # api-core ↔ design-agent
REVALIDATE_SECRET=CHANGE_ME_openssl_rand_hex_24     # Next.js ↔ api-core revalidate

# ── Worker ───────────────────────────────────────────────────────────────────
SHOP_BUILD_CONCURRENCY=2

# ── Design agent (DỊCH VỤ TRẢ PHÍ) ───────────────────────────────────────────
# Chỉ cần khi deploy service `design-agent` (tính năng Import theme từ Figma).
# Bỏ qua nếu KHÔNG chạy design-agent (khi đó nút Import Figma sẽ báo lỗi cấu hình).
ANTHROPIC_API_KEY=sk-ant-...            # Claude (extract layout + chatbot) — trả phí
VOYAGE_API_KEY=pa-...                   # Voyage AI (embeddings cho RAG) — trả phí
VOYAGE_MODEL=voyage-3                   # model embeddings mặc định
FIGMA_TOKEN=figd_...                    # Personal Access Token của Figma
# (tùy chọn) file key Figma mặc định khi extract — để TRỐNG nếu chưa cần:
FIGMA_FILE_KEY=
# DESIGN_AGENT_URL do compose set sẵn (http://design-agent:3100) — không cần ở đây.
# INTERNAL_API_KEY (ở trên) PHẢI giống nhau giữa api-core và design-agent.

# Google OAuth (Sign in with Google — owner admin + storefront buyer)
# Redirect URIs to register in Google Cloud Console:
#   https://api.tvgx1.id.vn/api/auth/owner/callback/google
#   https://api.tvgx1.id.vn/api/storefront-auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
