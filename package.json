{
  "name": "ecommerce-platform",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "security:audit": "npm audit",
    "security:audit:prod": "npm audit --omit=dev",
    "wsl:sync": "bash scripts/wsl-sync-run.sh --sync-only",
    "wsl:build": "bash scripts/wsl-sync-run.sh npm run build",
    "wsl:dev": "bash scripts/wsl-sync-run.sh --skip-install npm run dev",
    "wsl:test": "bash scripts/wsl-sync-run.sh npm test",
    "sync:layout": "npx tsx scripts/sync-layout.ts",
    "generate:master": "npx tsx scripts/generate-master.ts",
    "dev:loop": "bash scripts/dev-loop.sh up",
    "dev:status": "bash scripts/dev-loop.sh status",
    "dev:down": "bash scripts/dev-loop.sh down",
    "stop:quick": "bash scripts/stop-quick.sh",
    "stop:normal": "bash scripts/dev-loop.sh down",
    "stop:deep": "DELETE_PVCS=false PRUNE_ALL_IMAGES=false STOP_K3S=false bash scripts/stop-deep.sh",
    "verify:stop": "bash scripts/verify-stop.sh",
    "tunnel:up": "bash scripts/setup-cloudflare-tunnel.sh",
    "prisma:build": "cd packages/database && npm run schema:build",
    "prisma:generate": "cd packages/database && npm run schema:build && npx prisma generate",
    "prisma:migrate": "cd packages/database && npm run schema:build && npx prisma migrate dev",
    "prisma:studio": "cd packages/database && npm run schema:build && npx prisma studio"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "prisma": "^5.10.2",
    "resolve-pkg-maps": "^1.0.0",
    "turbo": "^2.9.6",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": "22.22.1"
  },
  "packageManager": "npm@10.9.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/minio": "^7.1.0",
    "better-auth": "^1.6.9",
    "dotenv": "^17.4.2",
    "iterare": "^1.2.1",
    "minio": "^8.0.7",
    "mongoose": "^9.5.0",
    "rxjs": "^7.8.1"
  }
}
